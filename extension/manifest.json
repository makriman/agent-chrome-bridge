{
  "manifest_version": 3,
  "name": "Agent Chrome Bridge",
  "description": "Give Grok Bot and other agents your Chrome. Local-only, user-armed tab control.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:18474/*",
    "http://localhost:18474/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agent Chrome Bridge"
  }
}
